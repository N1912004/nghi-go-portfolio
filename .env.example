# This file is documentation. The Go binary intentionally does not parse .env.
# Docker Compose reads .env automatically; for `go run`, export variables in shell.
PORT=8080
APP_ENV=development
PUBLIC_URL=http://localhost:8080
# For Compose only: replace with a unique, long, URL-safe password.
POSTGRES_PASSWORD=replace_with_a_unique_long_password
# Native Go + existing PostgreSQL: set this in your shell (not needed for Compose).
# DATABASE_URL=postgres://portfolio:YOUR_PASSWORD@localhost:5432/portfolio?sslmode=disable
# Production: APP_ENV=production, PUBLIC_URL=https://YOUR_DOMAIN, and real DATABASE_URL.
